{
  "name": "relay",
  "version": "0.1.0",
  "description": "Mission control for AI coding sessions",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "dev-log": "node scripts/dev-log.mjs",
    "mcp:dev-context": "node scripts/relay-mcp-dev-context.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "npm run build && electron .",
    "electron": "electron .",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@cursor/sdk": "^1.0.11",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "google-auth-library": "^10.6.2",
    "node-pty": "^1.0.0",
    "node-schedule": "^2.1.1",
    "zustand": "^4.5.0"
  },
  "build": {
    "appId": "dev.relay.app",
    "productName": "Relay",
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon/icon.icns",
      "target": "dir"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-schedule": "^2.1.8",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
